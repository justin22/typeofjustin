---
import IndexLayout from '../../layouts/IndexLayout.astro';
import { getCollection } from 'astro:content';
import { parseDate } from '../../utils/DateUtil';

const posts = (await getCollection('posts'))
  .filter((entry) => entry.data.published)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<IndexLayout title="Writing" description="I write about product, software, work, books, and the things I’m learning.">
  <ol>
    {posts.map((post) => (
      <li>
        <a class="index-row group" href={`/posts/${post.slug}`}>
          <span class="text-xl leading-snug tracking-[-0.015em]">{post.data.title}</span>
          <time class="utility-label pt-2 text-muted" datetime={post.data.date.toISOString()}>{parseDate(post.data.date)}</time>
        </a>
      </li>
    ))}
  </ol>
</IndexLayout>
