---
import Layout from './Layout.astro';
import BackLink from '../components/layout/BackLink.astro';

interface Props {
  title: string;
  description: string;
  showDescription?: boolean;
}

const { title, description, showDescription = true } = Astro.props;
---

<Layout title={`${title} — Justin George`} description={description}>
  <main id="main-content" class="p-2.5 sm:p-6">
    <div class="mx-auto min-h-[calc(100dvh-1.25rem)] max-w-frame overflow-hidden border border-line-strong bg-paper sm:min-h-[calc(100dvh-3rem)] sm:rounded-[0.25rem] lg:grid lg:h-[calc(100dvh-3rem)] lg:grid-cols-[29%_71%]">
      <aside class="flex flex-col border-b border-line-strong px-6 py-7 sm:px-10 sm:py-10 lg:min-h-0 lg:border-b-0 lg:border-r lg:px-12 lg:py-12">
        <BackLink href="/" label="Home" />

        <div class="flex flex-1 flex-col justify-center py-16 lg:py-12">
          <h1 class="max-w-[9ch] text-[clamp(3rem,4.5vw,4.75rem)] font-normal leading-[0.96] tracking-[-0.05em] text-balance">
            {title}
          </h1>
          {showDescription && (
            <p class="mt-8 max-w-[28ch] text-lg leading-relaxed text-muted">
              {description}
            </p>
          )}
        </div>

        {Astro.slots.has('rail-footer') && (
          <div class="shrink-0">
            <slot name="rail-footer" />
          </div>
        )}
      </aside>

      <section class="min-w-0 lg:h-full lg:overflow-y-auto lg:overscroll-contain" aria-label={`${title} index`}>
        <div class="mx-auto max-w-[70rem] px-6 py-14 sm:px-12 sm:py-20 lg:px-16 lg:pb-28 lg:pt-28 xl:px-20">
          <slot />
        </div>
      </section>
    </div>
  </main>
</Layout>
