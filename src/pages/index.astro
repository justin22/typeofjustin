---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { books } from '../data/books';

const posts = (await getCollection('posts'))
  .filter((entry) => entry.data.published)
  .map((entry) => ({
    title: entry.data.title,
    href: `/posts/${entry.slug}`,
    date: entry.data.date,
  }));

const interviews = (await getCollection('interviews'))
  .filter((entry) => entry.data.published)
  .map((entry) => ({
    title: entry.data.title,
    href: `/interviews/${entry.slug}`,
    date: entry.data.date,
  }));

const writing = [...posts, ...interviews].sort((a, b) => b.date.valueOf() - a.date.valueOf());
---

<Layout title="Justin George — Product, software, and the people who make it">
  <main id="main-content" class="p-2.5 sm:p-6">
    <div class="mx-auto grid min-h-[calc(100dvh-1.25rem)] max-w-frame overflow-hidden border border-line-strong bg-paper sm:min-h-[calc(100dvh-3rem)] sm:rounded-[0.25rem] lg:h-[calc(100dvh-3rem)] lg:grid-cols-[minmax(15rem,0.84fr)_minmax(22.5rem,1.22fr)_minmax(18rem,0.94fr)]">
      <aside class="min-w-0 border-line-strong lg:grid lg:grid-rows-[minmax(0,1fr)_minmax(13rem,0.72fr)] lg:border-r" aria-label="About Justin">
        <section class="overflow-auto">
          <div class="px-6 pb-10 pt-14 sm:px-10 sm:pb-14 sm:pt-20">
            <h1 class="mb-8 max-w-[11ch] text-[clamp(2.75rem,4vw,4rem)] font-normal leading-[0.96] tracking-[-0.045em] text-balance">Justin George</h1>
            <p class="max-w-[29ch] text-lg leading-[1.62] text-[#30312c]">
              Simplifying customer support at <a class="editorial-link focus-ring" href="https://sparrowdesk.com/">SparrowDesk</a>.
              Curious to learn, build, and iterate.
            </p>
          </div>
        </section>

        <section class="overflow-auto">
          <div class="px-6 pb-9 pt-7 sm:px-10 sm:pt-9">
            <ul>
              <li><a class="focus-ring group flex items-center justify-between border-b border-line py-4 no-underline transition-colors hover:text-accent" href="/career"><span>Career</span><span class="motion-arrow-right font-sans text-muted">→</span></a></li>
              <li><a class="focus-ring group flex items-center justify-between border-b border-line py-4 no-underline transition-colors hover:text-accent" href="https://twitter.com/georgemjustin"><span>X / Twitter</span><span class="motion-arrow-up-right font-sans text-muted">↗</span></a></li>
              <li><a class="focus-ring group flex items-center justify-between border-b border-line py-4 no-underline transition-colors hover:text-accent" href="https://www.linkedin.com/in/georgejustin22/"><span>LinkedIn</span><span class="motion-arrow-up-right font-sans text-muted">↗</span></a></li>
              <li><a class="focus-ring group flex items-center justify-between py-4 no-underline transition-colors hover:text-accent" href="/rss.xml"><span>RSS feed</span><span class="motion-arrow-right font-sans text-muted">→</span></a></li>
            </ul>
          </div>
        </section>
      </aside>

      <section class="min-w-0 border-t border-line-strong lg:overflow-auto lg:border-t-0 lg:border-r" aria-labelledby="writing-heading" data-scroll-panel>
        <header class="section-heading sticky top-0 z-10 bg-paper/95 backdrop-blur-sm">
          <h2 id="writing-heading" class="text-3xl font-normal leading-none tracking-[-0.035em]">Writings</h2>
        </header>
        <div class="scroll-fade scroll-fade-top" aria-hidden="true"></div>
        <ol class="px-6 pb-14 sm:px-10 sm:pb-20">
          {writing.map((item) => (
            <li>
              <a class="focus-ring group flex items-center justify-between gap-6 border-b border-line py-5 no-underline transition-colors duration-200 hover:text-accent sm:py-6" href={item.href}>
                <span class="text-lg leading-snug tracking-[-0.01em]">{item.title}</span>
                <span class="motion-arrow-right font-sans text-sm text-muted" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
        <div class="scroll-fade scroll-fade-bottom" aria-hidden="true"></div>
      </section>

      <section class="min-w-0 border-t border-line-strong lg:overflow-auto lg:border-t-0" aria-labelledby="library-heading" data-scroll-panel>
        <header class="section-heading sticky top-0 z-10 bg-paper/95 backdrop-blur-sm">
          <h2 id="library-heading" class="text-3xl font-normal leading-none tracking-[-0.035em]">Library</h2>
        </header>
        <div class="scroll-fade scroll-fade-top" aria-hidden="true"></div>
        <ul class="px-6 pb-14 sm:px-10 sm:pb-20">
          {books.map((book) => (
            <li>
              <a class="focus-ring group flex items-center justify-between gap-6 border-b border-line py-5 no-underline transition-colors duration-200 hover:text-accent sm:py-6" href={book.postSlug ? `/posts/${book.postSlug}` : '/library'}>
                <span class="text-lg leading-snug tracking-[-0.01em]">{book.title}</span>
                <span class="motion-arrow-right font-sans text-sm text-muted" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="scroll-fade scroll-fade-bottom" aria-hidden="true"></div>
      </section>
    </div>
  </main>

  <script>
    const scrollPanels = document.querySelectorAll<HTMLElement>('[data-scroll-panel]');

    scrollPanels.forEach((panel) => {
      const heading = panel.querySelector<HTMLElement>('.section-heading');

      const updateScrollCue = () => {
        const hasOverflow = panel.scrollHeight > panel.clientHeight + 2;
        const hasScrolled = panel.scrollTop > 2;
        const hasMore = panel.scrollTop + panel.clientHeight < panel.scrollHeight - 2;

        if (heading) {
          panel.style.setProperty('--scroll-heading-height', `${heading.offsetHeight}px`);
        }

        panel.dataset.scrolled = String(hasOverflow && hasScrolled);
        panel.dataset.scrollable = String(hasOverflow && hasMore);
      };

      panel.addEventListener('scroll', updateScrollCue, { passive: true });
      const resizeObserver = new ResizeObserver(updateScrollCue);
      resizeObserver.observe(panel);
      if (heading) resizeObserver.observe(heading);
      updateScrollCue();
    });
  </script>
</Layout>
