---
import IndexLayout from '../../layouts/IndexLayout.astro';

const career = [
  {
    companyName: 'SurveySparrow',
    designation: 'Associate Director of Engineering',
    period: 'Sep 2020 — Present',
    image: 'surveysparrow',
    highlights: [
      'Joined as a lead product developer, working primarily with Node.js and React.',
      'Moved into a technical architect role with a focus on frontend engineering.',
      'Led a team of around 25 frontend developers and helped build Twigs, SurveySparrow’s component library.',
    ],
  },
  {
    companyName: 'StayAbode Ventures',
    designation: 'Senior Frontend Engineer',
    period: 'Apr 2018 — Aug 2020',
    image: 'stayabode',
    highlights: [
      'Joined the co-living startup as a React developer and found my way into frontend engineering.',
      'Stayed with the team through the company’s acquisition.',
    ],
  },
  {
    companyName: 'Activ4Pets',
    designation: 'Software Developer',
    period: 'Apr 2018 — Nov 2018',
    image: 'active4pets',
    highlights: [
      'Built tools that helped vets and pet owners manage appointments.',
      'Worked with Laravel in a small startup team.',
    ],
  },
  {
    companyName: 'Wipro',
    designation: 'Software Engineer',
    period: 'Sep 2013 — Apr 2018',
    image: 'wipro',
    highlights: [
      'Started straight out of college and worked across Java, Hibernate, Struts, and Classic ASP.',
      'Helped address more than 600 security issues reported by Veracode in a legacy application.',
    ],
  },
];
---

<IndexLayout
  title="Career"
  description="A path through software development, frontend engineering, product systems, and team leadership."
  showDescription={false}
>
  <ul slot="rail-footer">
    <li><a class="focus-ring group flex items-center justify-between border-b border-line py-4 no-underline transition-colors hover:text-accent" href="https://twitter.com/georgemjustin"><span>X / Twitter</span><span class="motion-arrow-up-right font-sans text-muted" aria-hidden="true">↗</span></a></li>
    <li><a class="focus-ring group flex items-center justify-between border-b border-line py-4 no-underline transition-colors hover:text-accent" href="https://www.linkedin.com/in/georgejustin22/"><span>LinkedIn</span><span class="motion-arrow-up-right font-sans text-muted" aria-hidden="true">↗</span></a></li>
    <li><a class="focus-ring group flex items-center justify-between py-4 no-underline transition-colors hover:text-accent" href="/rss.xml"><span>RSS feed</span><span class="motion-arrow-right font-sans text-muted" aria-hidden="true">→</span></a></li>
  </ul>

  <ol class="border-t border-line-strong">
    {career.map((item) => (
      <li class="grid gap-6 border-b border-line py-8 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-10 sm:py-10">
        <div>
          <p class="utility-label text-muted">{item.period}</p>
        </div>
        <div>
          <div class="mb-5 flex items-start gap-4">
            <img alt="" src={`/company/${item.image}.png`} class="mt-1 h-8 w-8 rounded-sm object-contain" width="32" height="32" loading="lazy" />
            <div>
              <h2 class="text-2xl font-normal leading-tight tracking-[-0.025em]">{item.companyName}</h2>
              <p class="mt-1 font-sans text-xs text-muted">{item.designation}</p>
            </div>
          </div>
          <ul class="space-y-3 text-lg leading-relaxed text-[#30312c]">
            {item.highlights.map((highlight) => (
              <li class="grid grid-cols-[0.75rem_1fr] gap-2 before:mt-[0.72em] before:h-px before:bg-line-strong">{highlight}</li>
            ))}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</IndexLayout>
