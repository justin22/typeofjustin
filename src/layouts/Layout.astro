---
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title = 'Justin George', description = "Justin George writes about product, software, UX, and the people who make things.", image } = Astro.props;
const baseUrl = Astro.site?.toString() || 'https://typeofjust.in';
const ogImage = image
  ? image.startsWith('http')
    ? image
    : `${baseUrl}${image.startsWith('/') ? image : `/${image}`}`
  : `${baseUrl}/api/og`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="https://typeofjust.in/favicon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="typeof just.in"
      href={`${baseUrl.replace(/\/$/, '')}/rss.xml`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_in" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="Justin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@georgemjustin" />
    <meta name="twitter:creator" content="@georgemjustin" />
    <meta name="impact-site-verification" value="ecf6573d-2737-46e7-b5de-31db964a045b" />
  </head>
  <body class="font-serif">
    <a href="#main-content" class="focus-ring fixed left-4 top-4 z-50 -translate-y-20 bg-paper px-4 py-3 font-sans text-sm text-ink focus:translate-y-0">
      Skip to content
    </a>
    <slot />
    <script is:inline>
      window.va = window.va || function () {
        (window.vaq = window.vaq || []).push(arguments);
      };
    </script>
    <script defer src="/_vercel/insights/script.js"></script>
  </body>
</html>
