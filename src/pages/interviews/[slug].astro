---
import ReadingLayout from '../../layouts/ReadingLayout.astro';
import { getCollection } from 'astro:content';
import { DictionarySimple } from '../../components/common/dictionary/DictionarySimple';

export async function getStaticPaths() {
  const allInterviews = await getCollection('interviews');
  return allInterviews
    .filter((post) => post.data.published)
    .map((post) => ({
      params: { slug: post.slug },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const sortedPosts = (await getCollection('interviews'))
  .filter((p) => p.data.published)
  .sort((a, b) => b.data.position - a.data.position);
const postIndex = sortedPosts.findIndex((p) => p.slug === post.slug);
const nextPost = sortedPosts[postIndex + 1] ?? null;

const description =
  (typeof post.body === 'string'
    ? post.body.replace(/^---[\s\S]*?---/, '').replace(/[#*`\[\]()]/g, '').replace(/\s+/g, ' ').trim().substring(0, 160)
    : `${post.data.title} - typeofjust.in`) || `${post.data.title} - typeofjust.in`;

const baseUrl = Astro.site?.toString() || 'https://typeofjust.in';
const metaImage = post.data.image || `${baseUrl}/api/og?title=${encodeURIComponent(post.data.title)}`;
const wordCount = typeof post.body === 'string' ? post.body.trim().split(/\s+/).length : 0;
const readTime = Math.max(1, Math.ceil(wordCount / 220));
const publishedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(post.data.date);
---

<ReadingLayout
  title={post.data.title}
  description={description}
  image={metaImage}
  backHref="/interviews"
  backLabel="All interviews"
  date={publishedDate}
  readTime={readTime}
  nextHref={nextPost ? `/interviews/${nextPost.slug}` : undefined}
  nextTitle={nextPost?.data.title}
>
  <Content
    components={{
      Dictionary: DictionarySimple,
    }}
  />
</ReadingLayout>
