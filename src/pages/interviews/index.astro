---
import IndexLayout from '../../layouts/IndexLayout.astro';
import { getCollection } from 'astro:content';
import { parseDate } from '../../utils/DateUtil';

const interviews = (await getCollection('interviews'))
  .filter((entry) => entry.data.published)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<IndexLayout title="Talking with founders" description="Conversations about the choices, constraints, and small breakthroughs behind useful products.">
  <ol class="border-t border-line-strong">
    {interviews.map((interview) => (
      <li>
        <a class="index-row group" href={`/interviews/${interview.slug}`}>
          <span class="text-xl leading-snug tracking-[-0.015em]">{interview.data.title}</span>
          <time class="utility-label pt-2 text-muted" datetime={interview.data.date.toISOString()}>{parseDate(interview.data.date)}</time>
        </a>
      </li>
    ))}
  </ol>
</IndexLayout>
